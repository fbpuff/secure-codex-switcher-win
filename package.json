{
  "name": "secure-codex-switcher-win",
  "productName": "Secure Codex Switcher",
  "version": "2.15.0",
  "private": true,
  "author": "Secure Codex Switcher Contributors",
  "description": "A local-only Windows Codex account switcher with encrypted account storage and usage-aware switching.",
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "electron .",
    "package:dir": "electron-builder --win --x64 --dir",
    "package:win": "electron-builder --win nsis --x64",
    "test": "node --test tests/*.test.js",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "undici": "^8.5.0"
  },
  "devDependencies": {
    "electron": "^42.6.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.securecodexswitcher.windows",
    "productName": "Secure Codex Switcher",
    "asar": true,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/shortcut-icon-2.5.2.ico",
        "to": "shortcut-icon-2.5.2.ico"
      },
      {
        "from": "build/tray-icon-2.5.3.png",
        "to": "tray-icon-2.5.3.png"
      }
    ],
    "win": {
      "target": "nsis",
      "executableName": "Secure Codex Switcher",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Codex Switcher",
      "deleteAppDataOnUninstall": false
    }
  }
}
